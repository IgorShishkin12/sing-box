# Stage 1: build sing-box and e2e-loadtest for Android.
#
# Build args (override for arm64 real-device builds):
#   GOARCH        — go target arch  (default: amd64 for x86_64 emulator)
#   RUST_TARGET   — Rust target triple
#   NDK_CC        — NDK clang wrapper for Go CGO and loadtest linking
#
# Example arm64 invocation:
#   docker build \
#     --build-arg GOARCH=arm64 \
#     --build-arg RUST_TARGET=aarch64-linux-android \
#     --build-arg NDK_CC=aarch64-linux-android34-clang \
#     --target android-builder \
#     --output type=local,dest=./android-bins-arm64 \
#     -f e2e/Dockerfile.android-client .
ARG GOARCH=amd64
ARG RUST_TARGET=x86_64-linux-android
ARG NDK_CC=x86_64-linux-android34-clang

FROM golang:1.24 AS android-builder
ARG GOARCH
ARG RUST_TARGET
ARG NDK_CC

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl unzip build-essential ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Android NDK r28 — use find after unzip to handle any minor-version suffix (r28, r28b …)
ENV ANDROID_NDK_HOME=/opt/android-ndk
ENV TOOLCHAIN=$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64/bin
RUN curl -fsSL -o /tmp/ndk.zip \
        https://dl.google.com/android/repository/android-ndk-r28-linux.zip && \
    unzip -q /tmp/ndk.zip -d /opt && \
    find /opt -maxdepth 1 -name 'android-ndk-r28*' -type d \
        -exec mv {} $ANDROID_NDK_HOME \; && \
    rm /tmp/ndk.zip
ENV PATH=$PATH:$TOOLCHAIN

# Rust + Android target (arch-parametric)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        sh -s -- -y --default-toolchain stable --no-modify-path
ENV PATH=$PATH:/root/.cargo/bin
RUN rustup target add $RUST_TARGET

WORKDIR /workspace/sing-box
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .

# Rust bridge for x86_64-linux-android.
# Must cd into bridge/ first: Cargo resolves .cargo/config.toml from the
# working directory, not from the manifest path, so running with
# --manifest-path from the parent would miss bridge/.cargo/config.toml and
# fall back to the host `cc` linker, which doesn't have -llog / -lunwind.
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/tmp/cargo-target \
    cd bridge && \
    CARGO_TARGET_DIR=/tmp/cargo-target \
    cargo build --release --target $RUST_TARGET && \
    mkdir -p target/$RUST_TARGET/release && \
    cp /tmp/cargo-target/$RUST_TARGET/release/libsing_box_reticulum_bridge.a \
        target/$RUST_TARGET/release/

# sing-box for Android (arch-parametric).
# CGO directive in bridge_stub_reticulum.go picks up the .a above automatically
# based on GOOS=android + GOARCH.
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    export TAGS=$(cat release/DEFAULT_BUILD_TAGS_OTHERS) && \
    GOOS=android GOARCH=$GOARCH CGO_ENABLED=1 \
    CC=$TOOLCHAIN/$NDK_CC \
    go build -trimpath -tags "$TAGS,with_reticulum" \
        -o /android-bins/sing-box \
        ./cmd/sing-box/

# loadtest for Android (arch-parametric).
# Android always requires external (cgo) linking even for pure-Go binaries
# because the runtime links against Android's libc via the NDK clang.
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    GOOS=android GOARCH=$GOARCH CGO_ENABLED=1 \
    CC=$TOOLCHAIN/$NDK_CC \
    go build -o /android-bins/e2e-loadtest ./e2e/loadtest/

# ---------------------------------------------------------------------------
# Stage 2: Android emulator image
# SDK and system image are downloaded here so they land in a cached layer.
# ---------------------------------------------------------------------------
FROM ubuntu:22.04 AS android-client

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-17-jdk-headless curl unzip socat ca-certificates \
        libpulse0 libgl1 && \
    rm -rf /var/lib/apt/lists/*

# Android SDK command-line tools
ENV ANDROID_HOME=/opt/android-sdk
ENV PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator

RUN mkdir -p $ANDROID_HOME/cmdline-tools && \
    curl -fsSL -o /tmp/cmdline-tools.zip \
        https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip && \
    unzip -q /tmp/cmdline-tools.zip -d $ANDROID_HOME/cmdline-tools && \
    mv $ANDROID_HOME/cmdline-tools/cmdline-tools $ANDROID_HOME/cmdline-tools/latest && \
    rm /tmp/cmdline-tools.zip

# Accept licenses, then download emulator + system image (cached in this layer)
RUN yes | sdkmanager --licenses > /dev/null && \
    sdkmanager "platform-tools" "emulator" \
        "system-images;android-34;google_apis;x86_64"

# Create AVD (also cached)
RUN echo "no" | avdmanager create avd \
        -n reticulum_test \
        -k "system-images;android-34;google_apis;x86_64" \
        -d pixel_5 \
        --force

# Android binaries built in stage 1
COPY --from=android-builder /android-bins/sing-box      /android-bins/sing-box
COPY --from=android-builder /android-bins/e2e-loadtest  /android-bins/e2e-loadtest

# Entrypoint
COPY e2e/android-entrypoint.sh /android-entrypoint.sh
RUN chmod +x /android-entrypoint.sh

ENTRYPOINT ["/android-entrypoint.sh"]

# ---------------------------------------------------------------------------
# Minimal export stage — used by real-device-test.sh to extract just the two
# arm64 binaries without the rest of the builder filesystem:
#   podman build --target export --output type=local,dest=./android-bins-arm64 ...
# ---------------------------------------------------------------------------
FROM scratch AS export
COPY --from=android-builder /android-bins/sing-box      /android-bins/sing-box
COPY --from=android-builder /android-bins/e2e-loadtest  /android-bins/e2e-loadtest

# ---------------------------------------------------------------------------
# ble-deps — stable layer with all BLE tooling.
# Rebuilds only when tool versions change, not on code changes.
# Does NOT inherit from android-builder so its cache is independent.
# ---------------------------------------------------------------------------
FROM golang:1.24 AS ble-deps

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl unzip ca-certificates git default-jdk-headless && \
    rm -rf /var/lib/apt/lists/*

# Android SDK (cmdline-tools + platform + build-tools; no emulator)
ENV ANDROID_HOME=/opt/android-sdk
ENV PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin
RUN mkdir -p $ANDROID_HOME/cmdline-tools && \
    curl -fsSL -o /tmp/cmdline-tools.zip \
        https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip && \
    unzip -q /tmp/cmdline-tools.zip -d $ANDROID_HOME/cmdline-tools && \
    mv $ANDROID_HOME/cmdline-tools/cmdline-tools $ANDROID_HOME/cmdline-tools/latest && \
    rm /tmp/cmdline-tools.zip
RUN yes | sdkmanager --licenses > /dev/null && \
    sdkmanager "platforms;android-34" "build-tools;34.0.0"

# Gradle 8.7 for our APK build
RUN curl -fsSL https://services.gradle.org/distributions/gradle-8.7-bin.zip \
        -o /tmp/gradle.zip && \
    unzip -q /tmp/gradle.zip -d /opt && \
    ln -s /opt/gradle-8.7/bin/gradle /usr/local/bin/gradle && \
    rm /tmp/gradle.zip

# jni-utils Java sources — download the same crate tarball that cargo uses,
# so the Java class names always match the Rust library version exactly.
RUN curl -fsSL https://static.crates.io/crates/jni-utils/jni-utils-0.1.1.crate \
        -o /tmp/jni-utils.tar.gz && \
    mkdir /tmp/jni-utils && \
    tar -xzf /tmp/jni-utils.tar.gz -C /tmp/jni-utils --strip-components=1 && \
    cp -r /tmp/jni-utils/java/src/main/java /opt/jni-utils-java && \
    rm -rf /tmp/jni-utils /tmp/jni-utils.tar.gz

# btleplug Java sources — stash for direct compilation into the APK.
# No published AAR exists; compiling sources avoids the AGP 7.x/Gradle version maze.
RUN curl -fsSL https://static.crates.io/crates/btleplug/btleplug-0.11.8.crate \
        -o /tmp/btleplug.tar.gz && \
    mkdir /tmp/btleplug && \
    tar -xzf /tmp/btleplug.tar.gz -C /tmp/btleplug --strip-components=1 && \
    cp -r /tmp/btleplug/src/droidplug/java/src/main/java /opt/btleplug-java && \
    rm -rf /tmp/btleplug /tmp/btleplug.tar.gz

# ---------------------------------------------------------------------------
# ble-builder — code-specific build: .so + APK.
# Inherits stable tooling from ble-deps; copies only compiled artifacts
# (NDK + pre-built .a) from android-builder.
# ---------------------------------------------------------------------------
FROM ble-deps AS ble-builder
ARG GOARCH=arm64
ARG RUST_TARGET=aarch64-linux-android
ARG NDK_CC=aarch64-linux-android34-clang

# NDK (cross-compile the Go JNI .so)
COPY --from=android-builder /opt/android-ndk /opt/android-ndk
ENV ANDROID_NDK_HOME=/opt/android-ndk
ENV TOOLCHAIN=$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64/bin
ENV PATH=$PATH:$TOOLCHAIN

# Go source + pre-built Rust .a (already compiled in android-builder)
WORKDIR /workspace/sing-box
COPY --from=android-builder /workspace/sing-box /workspace/sing-box

# Build libsing-box-ble.so
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    mkdir -p /android-ble-bins && \
    export TAGS=$(cat release/DEFAULT_BUILD_TAGS_OTHERS) && \
    GOOS=android GOARCH=$GOARCH CGO_ENABLED=1 \
    CC=$TOOLCHAIN/$NDK_CC \
    go build -buildmode c-shared \
        -tags "$TAGS,with_reticulum" \
        -o /android-ble-bins/libsing-box-ble.so \
        ./cmd/ble-launcher/

# Place .so in the correct ABI dir; add btleplug Java sources into the project
RUN case "$GOARCH" in \
      arm64) ABI=arm64-v8a ;; \
      amd64) ABI=x86_64 ;; \
      arm)   ABI=armeabi-v7a ;; \
      386)   ABI=x86 ;; \
      *)     ABI=$GOARCH ;; \
    esac && \
    mkdir -p android-ble-wrapper/app/src/main/jniLibs/$ABI && \
    cp /android-ble-bins/libsing-box-ble.so \
       android-ble-wrapper/app/src/main/jniLibs/$ABI/libsing-box-ble.so && \
    mkdir -p android-ble-wrapper/app/src/main/java && \
    cp -r /opt/btleplug-java/. android-ble-wrapper/app/src/main/java/ && \
    cp -r /opt/jni-utils-java/. android-ble-wrapper/app/src/main/java/ && \
    cp -r android-ble-wrapper/app/btleplug-patches/. android-ble-wrapper/app/src/main/java/

RUN --mount=type=cache,target=/root/.gradle \
    cd android-ble-wrapper && \
    ANDROID_HOME=/opt/android-sdk gradle assembleDebug && \
    cp app/build/outputs/apk/debug/app-debug.apk /android-ble-bins/sing-box-ble.apk

# ---------------------------------------------------------------------------
# BLE export stage — extracts APK + e2e-loadtest for real-device-test.sh --ble
# ---------------------------------------------------------------------------
FROM scratch AS export-ble
COPY --from=ble-builder     /android-ble-bins/sing-box-ble.apk  /android-ble-apk/app-debug.apk
COPY --from=android-builder /android-bins/e2e-loadtest           /android-bins/e2e-loadtest
