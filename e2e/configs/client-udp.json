{
  "log": {
    "level": "info",
    "output": "/dev/stdout",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "reticulum",
      "tag": "reticulum-out",
      "name": "e2e-sum-server-udp",
      "password": "e2e-test-password",
      "reticulum_config": {
        "identity_name": "e2e-client-udp",
        "storage_path": "/var/lib/reticulum/client-udp",
        "interfaces": [
          {
            "name": "Reticulum UDP Client",
            "type": "UDPInterface",
            "forward_ip": "e2e-server-udp",
            "forward_port": 4243
          }
        ]
      }
    }
  ],
  "route": {
    "final": "reticulum-out"
  }
}
