{
  "log": {
    "level": "info",
    "output": "/var/log/sing-box-client.log"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "reticulum",
      "tag": "reticulum-out",
      "destination": "e2e-sum-server",
      "reticulum_config": {
        "storage_path": "/var/lib/reticulum/client",
        "interfaces": [
          {"name": "Reticulum TCP Client", "type": "TCPClientInterface",
           "target_host": "e2e-server", "target_port": 7788}
        ]
      }
    }
  ],
  "route": {
    "final": "reticulum-out"
  }
}
