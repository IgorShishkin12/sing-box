{
  "log": {
    "level": "info",
    "output": "/dev/stdout"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "reticulum",
      "tag": "reticulum-out",
      "name": "e2e-sum-server",
      "password": "e2e-test-password",
      "reticulum_config": {
        "identity_name": "e2e-client",
        "storage_path": "/var/lib/reticulum/client",
        "interfaces": [
          {
            "name": "Reticulum TCP Client",
            "type": "TCPClientInterface",
            "target_host": "e2e-server",
            "target_port": 7788
          }
        ]
      }
    }
  ],
  "route": {
    "final": "reticulum-out"
  }
}
