{
  "log": {
    "level": "info",
    "output": "/dev/stdout",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "reticulum",
      "tag": "reticulum-in",
      "name": "e2e-sum-server",
      "password": "e2e-test-password",
      "reticulum_config": {
        "identity_name": "e2e-server-ble",
        "storage_path": "/var/lib/reticulum/server-ble",
        "interfaces": [
          {
            "name": "RNode BLE Server",
            "type": "RNodeBLE",
            "peripheral_id": "RNode 9999",
            "frequency_hz": 433000000,
            "bandwidth_hz": 62500,
            "tx_power_dbm": 0,
            "spreading_factor": 8,
            "coding_rate": 6
          }
        ]
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": "reticulum-in",
        "outbound": "direct"
      }
    ],
    "final": "direct"
  }
}
