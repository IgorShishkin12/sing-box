{
  "log": {
    "level": "info",
    "output": "/dev/stdout",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "reticulum",
      "tag": "reticulum-in",
      "name": "e2e-sum-server",
      "password": "e2e-test-password",
      "reticulum_config": {
        "identity_name": "e2e-server",
        "storage_path": "/var/lib/reticulum/server-udp",
        "interfaces": [
          {
            "name": "Reticulum UDP Server",
            "type": "UDPInterface",
            "listen_ip": "0.0.0.0",
            "listen_port": 4243,
            "forward_ip": "e2e-client",
            "forward_port": 4242
          }
        ]
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": "reticulum-in",
        "outbound": "direct"
      }
    ],
    "final": "direct"
  }
}
