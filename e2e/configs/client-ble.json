{
  "log": {
    "level": "debug",
    "output": "/dev/stdout",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "reticulum",
      "tag": "reticulum-out",
      "name": "e2e-sum-server",
      "password": "e2e-test-password",
      "reticulum_config": {
        "identity_name": "e2e-client-ble",
        "storage_path": "/var/lib/reticulum/client-ble",
        "rust_log": "debug,serde=off,jni=off,btleplug=off,rns_transport::iface::rnode_ble=trace",
        "interfaces": [
          {
            "name": "RNode BLE Client",
            "type": "RNodeBLE",
            "peripheral_id": "${RNODE_BLE_CLIENT}",
            "frequency_hz": 433000000,
            "bandwidth_hz": 62500,
            "tx_power_dbm": 0,
            "spreading_factor": 8,
            "coding_rate": 6
          }
        ]
      }
    }
  ],
  "route": {
    "final": "reticulum-out"
  }
}
