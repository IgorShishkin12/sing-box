FROM golang:1.24-alpine AS builder

RUN apk add --no-cache rust cargo build-base git

WORKDIR /workspace/sing-box

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .

# Rust bridge — incremental via cache mount; copy only the .a into the layer
# so CGO can find it at bridge/target/release/ without the full target tree.
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/tmp/cargo-target \
    CARGO_TARGET_DIR=/tmp/cargo-target \
    cargo build --release --manifest-path bridge/Cargo.toml && \
    mkdir -p bridge/target/release && \
    cp /tmp/cargo-target/release/libsing_box_reticulum_bridge.a bridge/target/release/

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    export VERSION=$(go run ./cmd/internal/read_tag 2>/dev/null || echo "dev") && \
    export TAGS=$(cat release/DEFAULT_BUILD_TAGS_OTHERS) && \
    export LDFLAGS_SHARED=$(cat release/LDFLAGS) && \
    CGO_ENABLED=1 \
    go build -trimpath -tags "$TAGS,with_reticulum" \
        -o /usr/local/bin/sing-box \
        -ldflags "-X \"github.com/sagernet/sing-box/constant.Version=$VERSION\" $LDFLAGS_SHARED -s -w -buildid=" \
        ./cmd/sing-box/

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go build -o /usr/local/bin/e2e-loadtest ./e2e/loadtest/


FROM alpine:3.20

RUN apk add --no-cache bash curl ca-certificates libgcc libstdc++ coreutils

COPY --from=builder /usr/local/bin/sing-box /usr/local/bin/sing-box
COPY --from=builder /usr/local/bin/e2e-loadtest /usr/local/bin/e2e-loadtest

EXPOSE 1080

ENTRYPOINT ["/usr/bin/timeout", "300", "/bin/sh"]
