FROM golang:1.25-alpine AS builder

RUN apk add --no-cache rust cargo build-base

COPY . /workspace/sing-box
WORKDIR /workspace/sing-box

# Build Rust bridge (release for static linking)
RUN cd bridge && cargo build --release

# Build sing-box with reticulum bridge statically linked
RUN export COMMIT=$(git rev-parse --short HEAD) && \
    export VERSION=$(go run ./cmd/internal/read_tag) && \
    export TAGS=$(cat release/DEFAULT_BUILD_TAGS_OTHERS) && \
    export LDFLAGS_SHARED=$(cat release/LDFLAGS) && \
    CGO_ENABLED=1 \
    go build -v -trimpath -tags "$TAGS,with_reticulum" \
        -o /usr/local/bin/sing-box \
        -ldflags "-X \"github.com/sagernet/sing-box/constant.Version=$VERSION\" $LDFLAGS_SHARED -s -w -buildid=" \
        ./cmd/sing-box

# Build the sum server
RUN go build -o /usr/local/bin/sum-server ./e2e/sumserver/

# Build the E2E server (bridge listener + forwarder)
RUN CGO_ENABLED=1 go build -tags with_reticulum -o /usr/local/bin/e2e-server ./e2e/server/

# Build the E2E client (bridge dialer + HTTP test)
RUN CGO_ENABLED=1 go build -tags with_reticulum -o /usr/local/bin/e2e-client ./e2e/client/

FROM alpine:3.20

RUN apk add --no-cache bash curl ca-certificates

COPY --from=builder /usr/local/bin/sing-box /usr/local/bin/sing-box
COPY --from=builder /usr/local/bin/sum-server /usr/local/bin/sum-server
COPY --from=builder /usr/local/bin/e2e-server /usr/local/bin/e2e-server
COPY --from=builder /usr/local/bin/e2e-client /usr/local/bin/e2e-client

ENTRYPOINT ["sing-box"]