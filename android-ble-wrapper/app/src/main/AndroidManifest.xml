<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.singbox.ble">

    <!-- Legacy BLE permissions (API < 31) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <!-- Modern BLE permissions (API 31+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- Location permission required for BLE scan on Android < 12 (and some Android 12 OEMs) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Foreground service (required on API 26+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <!-- Required to bind the SOCKS5 proxy TCP socket on localhost -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application android:label="SingBox BLE">
        <activity
            android:name=".PermissionActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"/>
        <service
            android:name=".BleService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice"/>
    </application>
</manifest>
